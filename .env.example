# Application Configuration
SECRET_KEY=smart_freelance_invoice_secret_key_change_in_production
FLASK_ENV=development
DEBUG=True

# AI Assistant & Vision OCR Integration (Optional - Supports Groq, Gemini, and OpenAI)
# For Groq (Fastest & Free): AI_PROVIDER=groq, AI_MODEL=llama-3.3-70b-versatile, AI_API_KEY=gsk_...
# For Gemini: AI_PROVIDER=gemini, AI_MODEL=gemini-1.5-flash, AI_API_KEY=AIzaSy...
# For OpenAI: AI_PROVIDER=openai, AI_MODEL=gpt-3.5-turbo, AI_API_KEY=sk-...
AI_PROVIDER=groq
AI_API_KEY=your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile

# Tesseract OCR Executable Path (Optional if tesseract is in PATH)
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# SMTP Email Configuration for Payment Reminders (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password_here
SMTP_FROM=invoices@freelance.local
SMTP_USE_TLS=True
